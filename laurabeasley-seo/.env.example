# Copy to .env and fill in. .env is gitignored.

# Anthropic API — content drafting, GEO monitoring, alt text
ANTHROPIC_API_KEY=

# Google PageSpeed Insights (optional; audit works without it but with limited data)
PAGESPEED_API_KEY=

# Google Search Console / Business Profile use OAuth — place client_secret.json
# in the repo root and run the relevant module once to create token.json.
GSC_SITE_URL=https://laurabeasley.photography

# Where the weekly digest is emailed (optional). Leave blank to write to file only.
DIGEST_EMAIL_TO=
